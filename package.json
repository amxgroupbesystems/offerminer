{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --ssr server/index.ts --outDir server-dist && node server-dist/index.js",
    "build": "vite build && vite build --ssr server/index.ts --outDir server-dist",
    "start": "node server-dist/index.js",
    "import:apify": "vite build --ssr server/import-apify.ts --outDir scripts-dist && node scripts-dist/import-apify.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
    ,"test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.1",
